      alt="Kinesitherapeut tijdens behandeling">

    <span class="badge">✓ Geverifieerd</span>
    <span class="badge-top">Komt aan huis</span>
  </div>

  <h3>Mohamed El Amrani</h3>
  <p class="rating">⭐ 4.8 (89)</p>
  <p>Kinesitherapeut • 7 jaar</p>

  <div class="tags"><span>AR</span><span>NL</span></div>

  <div class="footer">
    <span class="price">niet geconventioneerd</span>
    <button>Contact</button>
  </div>
</div>
<div class="card">
  <div class="card-img">
    <img
      src="https://images.unsplash.com/photo-1580281657521-6f7f1f4536a8?auto=format&fit=crop&w=1200&q=80"
      alt="Thuisverpleegkundige aan huis">

    <span class="badge">✓ Geverifieerd</span>
    <span class="badge-top">Top</span>

    <img
      class="group-logo"
      src="images/logos/altrio.svg"
      alt="Altrio"
      title="Aangesloten bij Altrio Thuisverpleging">
  </div>

  <h3>Sarah Peeters</h3>
  <p class="rating">⭐ 4.9 (127)</p>
  <p>Thuisverpleegkundige • 10 jaar</p>
  <p>Onmiddellijke opstart mogelijk</p>

  <div class="tags"><span>NL</span><span>FR</span></div>

  <div class="footer">
    <span class="price">geconventioneerd</span>
    <button>Contact</button>
  </div>
</div>





